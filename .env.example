# ---------------------------------------------------------------------------
# Unique Trendz — environment variables (all optional)
# Copy to .env and adjust. Nothing here is required to run locally.
# ---------------------------------------------------------------------------

# Port the API + web server listens on (default 4000)
PORT=4000

# Password for the curator dashboard on first boot.
# The default is "unique2026" — change it in Settings after your first login,
# or set it here before the first run.
ADMIN_PASSWORD=unique2026

# Secret used to sign admin session tokens.
# If omitted, a random secret is generated and stored in data/.jwt-secret.
# JWT_SECRET=

# Where the catalogue JSON + uploads live (default: ./data).
# Point this at a persistent disk when deploying.
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads

# Only used by `npm run dev` — where Vite proxies /api to (default: 127.0.0.1:4000)
# API_TARGET=http://127.0.0.1:4000
